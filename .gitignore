# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo


# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Binary with embedded frontend
/artex
/artex.exe
/artex.exe.old
/artex.log
/artex.err.log
# Local rollback copies of the built binary; never commit
/artex.exe.bak
/artex.exe.prev
/artex.exe.new
# Timestamped rollback copies of the built binary; never commit
/artex.exe.bak-*
# Local database backups; never commit
/.backup/
# Self-update staging, backup, failed binary and marker
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# Runtime JWT signing key; never commit
/jwt.key

# Local Docker environment with passwords/keys; never commit
.env

# Local run artifacts (admin credential, session token, logs); never commit
.admin_pw.tmp
.admin_token.tmp
*.log

# Scheduler test event logs
*-events.csv

# Local benchmark artifacts
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
/scopeweaver
/scopeweaver.exe
/scopeweaver.new
/scopeweaver.new.sha256
/scopeweaver.old
/scopeweaver.failed
/scopeweaver.upgrade.json

# Local agent-adapter session artifacts
/adapters/agent/.session-token
