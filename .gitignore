# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single-binary build output with the embedded frontend
/artex
# Intermediate files that one-click update leaves next to the executable (staged binary / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never commit)
/jwt.key

# Local environment generated by the Docker deployment (contains passwords/keys, do not commit)
.env

# Event logs produced by scheduler runs/simulations (test artifacts, do not commit)
*-events.csv

# bench benchmark-related files (local artifacts, do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- artex-global local operations: never commit (owner's instruction: test/scan results stay private) ---
work/
test-results/
scan-output/
evidence-local/
# Runtime data created when the demo app is started locally (recording-proxy traffic index DB,
# mitmproxy CA private key, etc.), so it is not committed to the public repository (BRIEF boundary #2).
/demo-data/
*.local.env
# D2 model-comparison live test: it lives inside package agent, so it cannot be kept outside work/,
# and it is a local-only artifact that consumes OPENROUTER_API_KEY and the network, so it is not
# committed to the public repository (BRIEF boundary #2). Only the exact path is ignored, so upstream's tracked tests are left alone.
agent/d2_models_live_test.go

# API keys/secrets: never commit, wherever they live
*.env
secrets.env

# --- Local artifacts of a Windows source build: never commit ---
# Windows single binary produced by go build -o artex.exe (counterpart of the Unix /artex)
/artex.exe
# Secrets used in local configuration (e.g. the PostgreSQL password). Never commit.
/.secrets/
# Native binding cache created when SWC_NATIVE_BINDING_CACHE is redirected under the project
/.swc-cache/
# Runtime logs redirected when artex.exe is run in the foreground
/artex.out.log
/artex.err.log
