# syntax=docker/dockerfile:1
#
# Hardened, self-contained image for ARTEX (Go backend + embedded Next.js UI).
# Unlike ./Dockerfile (which only packs a locally compiled binary for the release
# CI), this file builds everything from source, then runs the result as an
# unprivileged user on a read-only root filesystem. Pair it with
# docker-compose.hardened.yml; usage and security notes are in
# docs/docker-hardened.md.
#
#   docker build -f Dockerfile.hardened -t artex-hardened:local .
#
# Base images are pinned to the digest of the multi-arch (amd64+arm64) index those tags
# currently resolve to, so a retag upstream cannot change what this file builds. Bump a
# digest together with its tag (docker buildx imagetools inspect <tag>).
ARG NODE_IMAGE=node:22-trixie-slim@sha256:2117f713a417f3aff682ac8f5bc2ebbdf1beed51f36e67ab1e0fd3866b6d2d8f
ARG GO_IMAGE=golang:1.26-trixie@sha256:a050dcceee6eb9bf110151662dfac7662f3bec40927c7dee48731e3d92083d42

# ---------- stage 1: static frontend export (web/out) ----------
FROM ${NODE_IMAGE} AS web
WORKDIR /src/web
ENV NEXT_TELEMETRY_DISABLED=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# --prod=false: the export needs devDependencies (@tailwindcss/postcss, ...) even
# when the build environment exports NODE_ENV=production (see README step 1).
# pnpm-workspace.yaml carries allowBuilds; pnpm 12 refuses to install without it
# because @parcel/watcher, @swc/core and sharp have build scripts.
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod=false
COPY web/ ./
RUN pnpm run build:static

# ---------- stage 2: single Go binary with the UI embedded ----------
FROM ${GO_IMAGE} AS build
WORKDIR /src
# go.mod pins a patch release; GOTOOLCHAIN stays on auto so a base image slightly
# behind it downloads the matching toolchain instead of failing the build.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Same layout `./build.sh` produces: server/webui/dist is what //go:embed reads.
COPY --from=web /src/web/out/ ./server/webui/dist/
ENV CGO_ENABLED=0
RUN go build -tags embedui -trimpath -buildvcs=false \
      -ldflags "-s -w -buildid=" -o /out/artex ./cmd/artex

# ---------- stage 3: runtime (unprivileged, no capabilities) ----------
FROM python:3.12-slim-trixie@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30 AS runtime
ARG TARGETARCH
ARG ARTEX_UID=10001
ARG ARTEX_GID=10001

# PLAYWRIGHT_BROWSERS_PATH: browsers live outside any home directory so they are
# usable by the non-root user. HOME=/tmp: the root filesystem is meant to be
# mounted read-only (see compose), so tools that cache in $HOME (pnpm, Chromium
# profiles) must land on the tmpfs at /tmp. PNPM_HOME and COREPACK_HOME sit outside
# /root because the runtime user is unprivileged and cannot read root's home; they only
# have to be readable (the global installs and corepack's cache are written at build
# time). COREPACK_HOME is pinned so the `pnpm` shim finds its cache instead of trying to
# re-download pnpm from the network at runtime.
ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PNPM_HOME=/usr/local/share/pnpm \
    COREPACK_HOME=/usr/local/share/corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    HOME=/tmp
ENV PATH="$PNPM_HOME:$PATH"

# Tools the agent invokes through its Bash tool, plus the reconnaissance set that
# ships with the upstream image. xz-utils is for the Node tarball below.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim less procps git jq unzip xz-utils \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*

# Node from the official release tarball, at a pinned version with pinned SHA256 sums,
# instead of `curl -fsSL https://deb.nodesource.com/setup_22.x | bash -`: that script
# runs whatever the remote serves, as root, with nothing to verify. The two hashes are
# the linux-x64 / linux-arm64 lines of
# https://nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt — bump version and both hashes
# together. Keep this block identical to ./Dockerfile's so both images ship one Node.
ARG NODE_VERSION=22.23.4
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) node_arch=x64;   node_sha=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce ;; \
      arm64) node_arch=arm64; node_sha=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/node.tar.xz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    echo "${node_sha}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm /tmp/node.tar.xz; \
    node --version; \
    [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 20 ]

# Playwright MCP + CLI + browser, pre-installed so a run never downloads a
# browser over the network mid-task. pnpm comes from the Node distribution's
# corepack, pinned to the version in web/package.json ("packageManager").
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate
RUN pnpm add -g @playwright/mcp playwright @playwright/cli \
    && playwright-cli --help \
    && playwright install --with-deps chromium \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
    && rm -rf /var/lib/apt/lists/*

# Defence in depth: no_new_privs already neutralises setuid, and no process in
# this image needs one. `|| true` keeps the build alive on filesystems that
# refuse the chmod.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + 2>/dev/null || true

RUN groupadd -g ${ARTEX_GID} artex \
    && useradd -u ${ARTEX_UID} -g ${ARTEX_GID} -M -s /usr/sbin/nologin artex

WORKDIR /app
COPY --from=build /out/artex /app/artex
COPY start.sh /app/start.sh
COPY --chown=${ARTEX_UID}:${ARTEX_GID} skills/ /app/skills/
# 0555: the binary is read-only at runtime (in-container self-update is disabled;
# upgrades come from a new image). skills/ stays writable so the UI editor works
# and Docker can seed the named volume with the image content.
RUN chmod 0555 /app/artex /app/start.sh \
    && mkdir -p /app/data \
    && chown -R ${ARTEX_UID}:${ARTEX_GID} /app/skills /app/data

USER ${ARTEX_UID}:${ARTEX_GID}

# 8787: UI + API. 8788: traffic-recording MITM proxy. That proxy has no
# authentication, so it is pinned to container loopback (the binary's own default)
# instead of `:8788`: nothing else on the Docker network can use it as an open
# proxy. Routing your own browser through it would require publishing the port and
# overriding this CMD — only on a host you trust.
EXPOSE 8787 8788
VOLUME ["/app/data", "/app/skills"]
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", "127.0.0.1:8788"]
