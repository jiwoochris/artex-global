# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the ghcr.io/yukiteruamano/artex-global image that docker-compose pulls.
# latest points at the most recent release; to pin a specific release, use a v* tag.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (set one or both; you can also leave them empty and configure it later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 첫 실행 보호 (관리자 계정 원격 선점 방지)
# - 웹/API 포트는 기본적으로 호스트의 127.0.0.1 에만 게시됩니다. 다른 기기에서 직접
#   접속해야 하면 ARTEX_BIND=0.0.0.0 으로 바꾸되, 초기 설정을 먼저 마치십시오.
# - 처음 기동하면 로그에 무작위 설정 토큰이 찍히고(docker compose logs artex),
#   /setup 화면에서 그 값을 입력해야 관리자 비밀번호를 만들 수 있습니다.
#   ARTEX_SETUP_TOKEN 을 지정하면 그 값이 토큰이 되고 로그에는 찍히지 않습니다.
# - ARTEX_ADMIN_PASSWORD 를 지정하면 /setup 없이 그 값으로 바로 초기화합니다(8자 이상).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 브라우저 교차 출처(CORS) 허용 목록(쉼표 구분). 내장 UI 는 동일 출처라 비워 둡니다.
ARTEX_CORS_ORIGINS=

# 서버 쪽 기본 출력 언어(en·ko·zh·es·ja). 비우면 영어입니다.
# - 에이전트 리포트·요약·대화 응답과 서버 오류 메시지의 기본값이 되며, 설정 화면에서
#   "표시 언어"를 고르면 그 값이 우선합니다.
# - 서버 콘솔 로그는 이 값만 따릅니다(설정 화면 선택과 무관).
# - 웹 화면 문구의 언어는 브라우저마다 설정 화면에서 고릅니다(기본 영어).
ARTEX_LANG=
