# Docker deployment configuration: copy to .env.
# Compose builds ScopeWeaver locally from this checkout.
SCOPEWEAVER_LANGUAGE=en
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Host address the web UI is published on. Defaults to 127.0.0.1, so the setup
# screen is only reachable from this machine. Set ARTEX_BIND=0.0.0.0 to serve
# other hosts; the server warns on startup while no admin password exists.
ARTEX_BIND=127.0.0.1

# First-run authentication. The admin password is set on the /setup screen.
# Leave both empty to generate a random setup token on first boot; read it from
#   docker compose logs scopeweaver | grep "Setup token:"
# and paste it into the setup screen. No API response ever returns it.
# Set ARTEX_SETUP_TOKEN to pin your own token (its value is never logged).
# Set ARTEX_ADMIN_PASSWORD to skip the setup screen on unattended deploys.
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=

# Extra browser origins allowed to call the API, comma separated. Defaults to the
# local Vite dev origins only; the embedded UI is same-origin and needs nothing.
# Use "*" only to restore the permissive legacy behaviour.
ARTEX_CORS_ORIGINS=

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Native Ollama is optional; cloud providers and external compatible endpoints remain supported.
# For host Ollama from Docker: http://host.docker.internal:11434
# For the optional Compose service: http://ollama:11434
OLLAMA_API_KEY=

# Optional generic credential override; leave this unset to use provider-specific keys.
# SCOPEWEAVER_LLM_API_KEY=your-key
SCOPEWEAVER_LLM_PROVIDER=
SCOPEWEAVER_LLM_MODEL=
SCOPEWEAVER_LLM_BASE_URL=
SCOPEWEAVER_LLM_PROXY=
SCOPEWEAVER_LOCAL_LLM_ONLY=false
# Optional native runtime overrides (unset uses provider defaults).
SCOPEWEAVER_LLM_CONTEXT_WINDOW_K=
SCOPEWEAVER_LLM_KEEP_ALIVE=
SCOPEWEAVER_LLM_MAX_CONCURRENT=
# Optional extra VPN/private network CIDRs when strict local mode is enabled.
SCOPEWEAVER_LOCAL_LLM_ALLOWED_CIDRS=
