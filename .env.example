# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the ghcr.io/yukiteruamano/artex-global image that docker-compose pulls.
# latest points at the most recent release; to pin a specific release, use a v* tag.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (set one or both; you can also leave them empty and configure it later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents a remote party from claiming the admin account)
# - The web/API port is published on the host's 127.0.0.1 only. If another machine must
#   reach it directly, set ARTEX_BIND=0.0.0.0 — but finish the initial setup first.
# - On first start a random setup token is printed to the log (docker compose logs artex);
#   enter it on the /setup page to create the admin password.
#   If you set ARTEX_SETUP_TOKEN, that value becomes the token and it is not logged.
# - If you set ARTEX_ADMIN_PASSWORD, it initializes the password directly without /setup (8+ chars).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allow-list, comma separated. The embedded UI is same-origin, so leave it empty.
ARTEX_CORS_ORIGINS=

# Server-side default output language (en or es). Empty means English.
# - It is the default for agent reports, summaries and chat replies and for server error messages;
#   the "display language" chosen in the settings UI takes precedence.
# - Server console logs follow this value only (independent of the settings UI).
# - The web UI language is chosen per browser in the settings UI (English by default).
ARTEX_LANG=
