# Docker deployment settings (copy this file to .env)
# ARTEX_TAG is the tag of the image ghcr.io/jiwoochris/artex-global that docker-compose pulls.
# latest points at the most recent release; to pin a specific release, put a v* tag here.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill in either one or both. You can also leave these empty and configure them later in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents someone remotely claiming the admin account first)
# - By default the web/API port is published only on the host's 127.0.0.1. If you need to reach it
#   directly from another machine, change ARTEX_BIND=0.0.0.0, but finish the initial setup first.
# - On first start a random setup token is printed to the log (docker compose logs artex), and you
#   must enter that value on the /setup screen before you can create the admin password.
#   If you set ARTEX_SETUP_TOKEN, that value becomes the token and it is not printed to the log.
# - If you set ARTEX_ADMIN_PASSWORD, the server initializes with that value directly, skipping /setup (8+ characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist (comma-separated). The built-in UI is same-origin, so leave this empty.
ARTEX_CORS_ORIGINS=

# Server-side default output language (en·ko·zh·es·ja). Empty means English.
# - It becomes the default for agent reports, summaries, chat replies and server error messages; if a
#   "display language" is chosen on the settings screen, that value takes precedence.
# - The server console log follows only this value (independent of the settings-screen choice).
# - The language of the web UI text is chosen per browser on the settings screen (English by default).
ARTEX_LANG=
